# Agent CLI flags for the platform-poc-001 workflow.
# Spec Kit 1.0.12 passes these to the agent CLIs it dispatches
# (SPECKIT_INTEGRATION_<KEY>_EXTRA_ARGS). Load them before `run` and `resume`:
#   set -a; . .specify/workflows/platform-poc-001/agent-flags.env; set +a
# The preflight step refuses to start if these are missing or contain
# permission-bypass flags.

# Codex (architect/reviewer): may write only inside the repository;
# its final message is saved so the workflow can commit it as a review artifact.
SPECKIT_INTEGRATION_CODEX_EXTRA_ARGS='--sandbox workspace-write --output-last-message .agent-out/codex-last-message.md'

# Claude (implementer): auto-accepts file edits in the repository and may run
# only the listed command families; any other tool use is denied, not prompted.
SPECKIT_INTEGRATION_CLAUDE_EXTRA_ARGS='--permission-mode acceptEdits --allowedTools "Read,Edit,Write,Glob,Grep,Bash(npm *),Bash(npx *),Bash(node *),Bash(git status*),Bash(git diff*),Bash(git log*),Bash(ls *),Bash(.specify/scripts/bash/*),Bash(docker compose *)"'

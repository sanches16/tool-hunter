# Local PostgreSQL connection settings for the foundation health app.
# Copy to an ignored local file (`cp -n .env.example .env`) and set POSTGRES_PASSWORD there to a
# locally generated value. Never commit the real password or any local .env file.
#
# Docker Compose reads these values for both services: `db` initializes the database/role with them
# and `app` connects to service `db` on port 5432 with the same database, user and password.
# Changing them later does not redefine the role in an existing local database volume.
#
# Database settings are server-side only: do not add NEXT_PUBLIC_* database variables or a
# credential-bearing connection URL (for example DATABASE_URL).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=foundation
POSTGRES_USER=foundation
# Required. Leave empty here; supply a locally generated password only in your ignored .env file.
POSTGRES_PASSWORD=
